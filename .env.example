# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_APP_URL="MY_APP_URL"

# Meta Threads Developer app credentials for OAuth flow
THREADS_APP_ID="2270750866796278"
THREADS_APP_SECRET=
VITE_THREADS_APP_ID="2270750866796278"

# Google Analytics Measurement ID (G-XXXXXXXXXX)
VITE_GA_TRACKING_ID=

# Stripe Subscription Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=

# Cash Machine AI Server-to-Server Integration (Server-only secret and URL)
CASH_MACHINE_AI_URL=
CASH_MACHINE_AI_TOKEN=

