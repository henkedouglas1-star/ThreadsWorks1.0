rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isFounder(uid) {
      return uid == "vtMSWyRs4YbUqwwCZsdW3Tvv2wk2" || uid == "Z8in1LtL13PjzcFq2PgmY9LwTYH3";
    }
    function canAccessUser(targetUid) {
      return request.auth != null && (request.auth.uid == targetUid || (isFounder(request.auth.uid) && isFounder(targetUid)));
    }

    // User profile documents - isolated by authenticated UID
    match /users/{userId} {
      allow read, write: if canAccessUser(userId);
      match /saved_tabs/{tabId} {
        allow read, write: if canAccessUser(userId);
      }
      match /generation_intelligence/{docId} {
        allow read, write: if canAccessUser(userId);
      }
    }
    // Posts collection - verified user ownership
    match /posts/{postId} {
      allow create: if request.auth != null 
                    && canAccessUser(request.resource.data.userId)
                    && (!('scheduledFor' in request.resource.data) || request.resource.data.scheduledFor == null || (request.resource.data.scheduledFor is timestamp && request.resource.data.scheduledFor > request.time));
      allow read, delete: if request.auth != null && (resource == null || canAccessUser(resource.data.userId));
      allow update: if request.auth != null 
                    && (resource == null || canAccessUser(resource.data.userId))
                    && (!('scheduledFor' in request.resource.data) || request.resource.data.scheduledFor == null || (request.resource.data.scheduledFor is timestamp && request.resource.data.scheduledFor > request.time) || (resource != null && 'scheduledFor' in resource.data && request.resource.data.scheduledFor == resource.data.scheduledFor));
    }
    // Saved hooks - verified user ownership
    match /saved_hooks/{hookId} {
      allow create: if request.auth != null && canAccessUser(request.resource.data.userId);
      allow read, update, delete: if request.auth != null && (resource == null || canAccessUser(resource.data.userId));
    }
    // User settings - isolated by authenticated UID
    match /settings/{settingsId} {
      allow read, write: if canAccessUser(settingsId) || (resource != null && canAccessUser(resource.data.userId)) || (request.resource != null && canAccessUser(request.resource.data.userId));
    }
    // Threads public connection status
    match /connections/{userId} {
      allow read, write: if canAccessUser(userId);
    }
    // Threads secure credentials record
    match /connections_secure/{userId} {
      allow read, write: if canAccessUser(userId);
    }
    // App global configuration (read-only for clients)
    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }
    // Publish log entries
    match /publishes/{publishId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
    // Stripe customer and subscription records (server authoritative)
    match /generation_usage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /stripe_subscriptions/{subId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /stripe_customers_by_user/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /stripe_customers/{custId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /stripe_processed_events/{eventId} {
      allow read, write: if false;
    }
    match /stripe_events_log/{logId} {
      allow read, write: if false;
    }
    match /stripe_invoices/{invoiceId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    // Analytics account snapshots
    match /analytics_account/{docId} {
      allow read, write: if request.auth != null && (docId == request.auth.uid || (resource != null && resource.data.userId == request.auth.uid) || (request.resource != null && request.resource.data.userId == request.auth.uid));
    }
    // Analytics post records
    match /analytics_posts/{docId} {
      allow read, write: if request.auth != null && ((resource != null && resource.data.userId == request.auth.uid) || (request.resource != null && request.resource.data.userId == request.auth.uid));
    }
    // Analytics sync state records
    match /analytics_sync_state/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Strategic Content Opportunities
    match /strategy_opportunities/{oppId} {
      allow read, write: if request.auth != null && ((resource != null && resource.data.userId == request.auth.uid) || (request.resource != null && request.resource.data.userId == request.auth.uid));
    }
    // Learned Strategies
    match /learned_strategies/{stratId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
    // Saved Influencers / Creators
    match /saved_influencers/{infId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
    // Discovered Creators / Shared Search Index (Server-written only)
    match /discovered_creators/{creatorId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Influencer Outreach Events & Tracking
    match /influencer_outreach_events/{eventId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
    // Influencer Campaign Folders
    match /influencer_campaigns/{campId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
    // Partner Hub Profiles
    match /partners/{userId} {
      allow read, write: if request.auth != null && (userId == request.auth.uid || (resource != null && resource.data.userId == request.auth.uid) || (request.resource != null && request.resource.data.userId == request.auth.uid));
    }
    // Partner Referral Code Registry
    match /partner_codes/{code} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }
    // Partner Referral Clicks
    match /referral_clicks/{clickId} {
      allow create, read: if true;
    }
    // Partner Customer Attributions
    match /partner_customers/{custId} {
      allow read, write: if request.auth != null && ((resource != null && (resource.data.partnerId == request.auth.uid || resource.data.userId == request.auth.uid)) || (request.resource != null && (request.resource.data.partnerId == request.auth.uid || request.resource.data.userId == request.auth.uid)));
    }
    // Partner Commissions
    match /commissions/{commId} {
      allow read: if request.auth != null && (resource == null || resource.data.partnerId == request.auth.uid);
      allow write: if false;
    }
    // Partner Payouts
    match /payouts/{payoutId} {
      allow read: if request.auth != null && (resource == null || resource.data.partnerId == request.auth.uid);
      allow write: if false;
    }
    // Partner Audit Logs
    match /partner_audit_logs/{logId} {
      allow read: if request.auth != null && (resource == null || resource.data.partnerId == request.auth.uid);
      allow write: if false;
    }
    // Partner Notifications
    match /partner_notifications/{notifId} {
      allow read, update: if request.auth != null && (resource == null || resource.data.partnerId == request.auth.uid);
      allow create: if request.auth != null;
    }
    // Generation jobs
    match /generation_jobs/{jobId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
    // Creator Outreach batches
    match /creator_outreach_batches/{batchId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
    // Shared Creator Projects - hardened validation & ownership immutability
    match /projects/{projectId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string 
                    && request.resource.data.name.size() > 0 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.objective is string
                    && request.resource.data.objective.size() <= 200
                    && request.resource.data.status in ['active', 'archived', 'completed'];
      allow update: if request.auth != null 
                    && resource != null 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.name is string 
                    && request.resource.data.name.size() > 0 
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.status in ['active', 'archived', 'completed'];
      allow delete: if request.auth != null 
                    && resource != null 
                    && resource.data.userId == request.auth.uid;
    }

    // =====================================================================
    // ContentPaysUs Master Ecosystem Collections (Strict Owner Isolation)
    // =====================================================================
    function isOwnerResource() {
      return request.auth != null && resource != null && resource.data.userId == request.auth.uid;
    }
    function isOwnerCreate() {
      return request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    function preservesOwnerOnUpdate() {
      return isOwnerResource() && request.resource.data.userId == resource.data.userId;
    }

    // Persistent ecosystem assets across all 20 apps
    match /ecosystem_assets/{assetId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isOwnerCreate()
                    && request.resource.data.appId is string
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 160;
      allow update: if preservesOwnerOnUpdate()
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 160;
      allow delete: if isOwnerResource();
    }

    // Shared Intelligence contributions (creator inspect & delete)
    match /intelligence_contributions/{contribId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isOwnerCreate() && request.resource.data.sourceAppId is string;
      allow update: if preservesOwnerOnUpdate();
      allow delete: if isOwnerResource();
    }

    // ProductWorks saved packages & usage counters (server-authoritative usage)
    match /funnelworks_projects/{userId}/projects/{projectId} {
      allow read, write: if canAccessUser(userId);
    }
    match /funnelworks_usage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // SalesWorks CRM contacts
    match /crm_contacts/{contactId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isOwnerCreate() && request.resource.data.name is string && request.resource.data.name.size() <= 120;
      allow update: if preservesOwnerOnUpdate();
      allow delete: if isOwnerResource();
    }

    // StoreWorks listings
    match /store_listings/{listingId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isOwnerCreate() && request.resource.data.title is string && request.resource.data.title.size() <= 160;
      allow update: if preservesOwnerOnUpdate();
      allow delete: if isOwnerResource();
    }

    // DeliveryWorks digital portals
    match /delivery_items/{itemId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isOwnerCreate() && request.resource.data.title is string && request.resource.data.title.size() <= 160;
      allow update: if preservesOwnerOnUpdate();
      allow delete: if isOwnerResource();
    }

    // CommunityWorks creator social network (authenticated read; author/participant writes)
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource != null && resource.data.authorId == request.auth.uid;
    }
    match /community_groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource != null && resource.data.ownerId == request.auth.uid;
    }
    match /community_messages/{msgId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid && request.auth.uid in request.resource.data.participants;
      allow update, delete: if false;
    }
    match /community_follows/{followId} {
      allow read: if request.auth != null && (resource == null || resource.data.followerId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null && resource != null && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }
    match /community_moderation/{modId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isOwnerCreate();
      allow update, delete: if false;
    }

    // MeetingWorks persistent rooms & chat
    match /meetings/{meetingId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isOwnerCreate() && request.resource.data.title is string && request.resource.data.title.size() <= 160;
      allow update: if preservesOwnerOnUpdate();
      allow delete: if isOwnerResource();
    }

    // ProofWorks evidence library
    match /proof_items/{proofId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isOwnerCreate() && request.resource.data.customerName is string;
      allow update: if preservesOwnerOnUpdate();
      allow delete: if isOwnerResource();
    }

    // TeamWorks shared workspaces
    match /team_workspaces/{workspaceId} {
      allow read: if request.auth != null && (resource == null || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null && resource != null && resource.data.ownerId == request.auth.uid;
    }

    // AffiliateWorks partner programs
    match /affiliate_programs/{programId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isOwnerCreate();
      allow update: if preservesOwnerOnUpdate();
      allow delete: if isOwnerResource();
    }

    // AutomationWorks workflows & server-logged runs
    match /automation_workflows/{workflowId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isOwnerCreate();
      allow update: if preservesOwnerOnUpdate();
      allow delete: if isOwnerResource();
    }
    match /automation_runs/{runId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // FinanceWorks real creator ledger & invoices
    match /finance_entries/{entryId} {
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isOwnerCreate() && request.resource.data.amountCents is number && request.resource.data.amountCents > 0;
      allow update: if preservesOwnerOnUpdate();
      allow delete: if isOwnerResource();
    }

    // ContentPaysUs Academy persistent progress (1 doc per user)
    match /academy_progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
